      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Lista de Mercado",
      "short_name": "Mercado",
      "description": "Revisa los productos pendientes para el súper",
      "url": "./index.html?tab=market",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "categories": ["finance", "productivity", "shopping"]
